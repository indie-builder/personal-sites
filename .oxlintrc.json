{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "plugins": ["react", "jsx-a11y", "nextjs"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off",
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": ["about-printer", "about-printer__*", "curation-*", "ai-news-*"]
      }
    ],
    "shadcn/no-raw-colors": "error"
  },
  "settings": {
    "shadcn": {
      "mergeFunctions": ["cn"],
      "variantFunctions": ["cva"],
      "note": "设计约束见 DESIGN.md 与 AGENTS.md；颜色一律走主题语义 token。"
    }
  },
  "ignorePatterns": [
    ".next/**",
    "coverage/**",
    "data/**",
    "knowledge/**",
    "node_modules/**",
    "out/**",
    "public/**",
    "tools/**",
    "var/**"
  ]
}
