{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "nextjs"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": [
    ".next/**",
    "coverage/**",
    "data/**",
    "knowledge/**",
    "node_modules/**",
    "out/**",
    "public/**",
    "tools/**",
    "var/**"
  ]
}
