{
  "pages": [
    "pages/home/index",
    "pages/ask/index",
    "pages/portfolio/index",
    "pages/about/index",
    "pages/detail/index",
    "pages/collection/index",
    "pages/work/index"
  ],
  "window": {
    "navigationBarTitleText": "陈远小站",
    "pageOrientation": "auto",
    "navigationBarBackgroundColor": "@surface",
    "navigationBarTextStyle": "@navigationText",
    "backgroundColor": "@surface",
    "backgroundTextStyle": "@backgroundText"
  },
  "tabBar": {
    "color": "@muted",
    "selectedColor": "@ink",
    "backgroundColor": "@surface",
    "borderStyle": "@borderStyle",
    "list": [
      { "pagePath": "pages/home/index", "text": "动态", "iconPath": "assets/navigation/home-muted.png", "selectedIconPath": "@homeIcon" },
      { "pagePath": "pages/ask/index", "text": "问一问", "iconPath": "assets/navigation/ask-muted.png", "selectedIconPath": "@askIcon" },
      { "pagePath": "pages/portfolio/index", "text": "作品集", "iconPath": "assets/navigation/portfolio-muted.png", "selectedIconPath": "@portfolioIcon" },
      { "pagePath": "pages/about/index", "text": "关于我", "iconPath": "assets/navigation/about-muted.png", "selectedIconPath": "@aboutIcon" }
    ]
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "networkTimeout": { "request": 120000, "downloadFile": 30000 }
}
