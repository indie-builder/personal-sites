<view class="page about-page {{reducedMotion ? 'motion-reduced' : ''}}">
  <view class="external-links">
    <button wx:for="{{links}}" wx:key="url" class="profile-link quiet" data-url="{{item.url}}" bindtap="copyProfileLink" aria-label="复制{{item.label}}链接">{{item.label}}</button>
  </view>
  <view class="meta link-hint">轻点链接复制，在浏览器中打开。</view>
  <view class="identity">
    <view>
      <text class="identity-name">{{profile.name}}</text>
      <text class="meta identity-handle">@{{profile.handle}}</text>
    </view>
    <image class="avatar" src="/assets/avatar.png" mode="aspectFit" aria-label="陈远的头像插画" />
  </view>
  <button class="career-toggle divider motion-control" bindtap="toggleCareer" hover-class="motion-press" aria-label="查看个人经历" aria-expanded="{{careerOpen}}">
    <text>2014—至今</text>
    <text class="meta">个人经历</text>
    <view class="career-chevron" aria-hidden="true"></view>
  </button>
  <view class="biography">
    <text class="section-title greeting">你好，</text>
    <text wx:for="{{profile.paragraphs}}" wx:key="*this" class="body muted bio-paragraph" user-select="true">{{item}}</text>
  </view>
  <view class="technical-terms divider" aria-label="技术词条">
    <text wx:for="{{terms}}" wx:key="*this" class="technical-term" user-select="true">{{item}}</text>
  </view>
  <view class="motion-setting">
    <text class="motion-setting-label">减少动态效果</text>
    <switch checked="{{reducedMotion}}" bindchange="onReducedMotionChange" color="#1c1c1e" aria-label="减少动态效果" />
  </view>
  <button class="website-link" bindtap="copyWebsite">复制个人网站链接</button>
  <view class="career-motion-probe" aria-hidden="true"></view>
  <page-container show="{{careerOpen}}" position="bottom" round overlay duration="{{reducedMotion ? 0 : careerDuration}}" close-on-slide-down="{{false}}" custom-style="background: var(--surface); color: var(--ink); border-radius: 24px 24px 0 0;" overlay-style="background-color: rgba(0,0,0,.28);" bindclickoverlay="closeCareer" bindleave="onCareerLeave" bindafterleave="onCareerAfterLeave">
    <view class="career-sheet" aria-role="dialog" aria-label="个人经历">
      <view class="career-grabber" aria-hidden="true"></view>
      <view class="career-sheet-header">
        <view><text class="career-sheet-name">陈远 / CHEN YUAN</text><text class="meta">个人经历 · CAREER RECEIPT</text></view>
        <button class="career-close" bindtap="closeCareer" hover-class="motion-press" aria-label="关闭个人经历">关闭</button>
      </view>
      <scroll-view class="career-scroll" scroll-y enhanced show-scrollbar="{{false}}" aria-label="个人经历内容">
        <view class="career-receipt">
          <view wx:for="{{career}}" wx:key="company" class="career-row">
            <view class="career-heading"><text>{{item.company}}</text><text class="muted">{{item.years}}</text></view>
            <text class="meta" user-select="true">{{item.meta}}</text>
          </view>
          <view class="career-total"><text class="muted">合计 TOTAL</text><text>12 年</text></view>
          <text class="meta">十二年 · 四段路 · 仍在增长</text>
        </view>
      </scroll-view>
    </view>
  </page-container>
</view>
