.external-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px 16px; }
.profile-link { min-width: 44px; min-height: 44px; padding: 8px 0; font-weight: 400; }
.link-hint { text-align: right; }
.identity { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 0; }
.identity-name { display: block; font-size: 32px; line-height: 1.3; font-weight: 500; letter-spacing: -.03em; }
.identity-handle { display: block; margin-top: 8px; font-size: 13px; font-weight: 400; }
.avatar { width: 96px; height: 96px; flex-shrink: 0; }
button.career-toggle { display: flex; width: 100%; min-height: 56px; gap: 12px; align-items: center; padding: 10px 0; text-align: left; border-radius: 0; font-size: 14px; font-weight: 500; }
.career-toggle .meta { font-size: 12px; font-weight: 400; }
.career-chevron { margin-left: auto; width: 7px; height: 7px; flex-shrink: 0; border-right: 1px solid var(--muted); border-top: 1px solid var(--muted); transform: rotate(45deg); }
.career-motion-probe { position: fixed; width: 0; height: 0; pointer-events: none; opacity: 1; }
@media (prefers-reduced-motion: reduce) { .career-motion-probe { opacity: 0; } }
.career-sheet { display: flex; flex-direction: column; max-width: 760px; height: 68vh; max-height: 640px; margin: 0 auto; padding: 10px 24px calc(16px + env(safe-area-inset-bottom)); }
.career-grabber { align-self: center; width: 32px; height: 4px; flex-shrink: 0; margin-bottom: 12px; border-radius: 2px; background: var(--line); }
.career-sheet-header { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 16px; border-bottom: 1px solid var(--ink); }
.career-sheet-name, .career-sheet-header .meta { display: block; }
.career-sheet-name { font-size: 16px; line-height: 1.6; font-weight: 500; }
button.career-close { min-width: 44px; padding: 8px 0 8px 8px; font-size: 13px; }
.career-scroll { flex: 1; min-height: 0; height: 0; }
.career-receipt { padding: 8px 0 20px; }
.section-title { display: block; font-size: 18px; font-weight: 600; line-height: 1.5; }
.career-row { padding: 12px 0; }
.career-heading, .career-total { display: flex; justify-content: space-between; gap: 16px; }
.career-heading { font-size: 15px; }
.career-row .meta { display: block; margin-top: 4px; }
.career-total { padding-top: 18px; margin-top: 8px; border-top: 1px solid var(--line); }
.career-total + .meta { display: block; margin-top: 8px; }
.biography { padding-top: 28px; }
.greeting { margin-bottom: 16px; }
.bio-paragraph { display: block; margin-bottom: 16px; }
.technical-terms { display: flex; flex-wrap: wrap; column-gap: 24px; row-gap: 18px; padding: 20px 0 28px; }
.technical-term { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; line-height: 1.6; }
.motion-setting { display: flex; min-height: 44px; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 0; }
.motion-setting-label { font-size: 14px; }
.website-link { display: table; margin-top: 16px; padding-left: 0; color: var(--muted); }
@media (max-width: 350px) { .career-sheet { padding-left: 16px; padding-right: 16px; } }
@media (max-height: 480px) { .career-sheet { height: 85vh; } }
