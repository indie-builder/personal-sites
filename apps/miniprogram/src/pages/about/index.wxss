.external-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px 12px; }
.profile-link { padding: 8px 0; }
.identity { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 0; }
.identity-name { display: block; font-size: 32px; line-height: 1.3; font-weight: 600; letter-spacing: -.03em; }
.identity-handle { display: block; margin-top: 7px; }
.avatar { width: 104px; height: 104px; flex-shrink: 0; }
.career-toggle { display: flex; width: 100%; min-height: 56px; gap: 12px; align-items: center; padding: 10px 0; text-align: left; border-radius: 0; }
.career-toggle-action { margin-left: auto; font-size: 12px; }
.career-receipt { padding: 24px 0; border-bottom: 1px solid var(--line); }
.section-title { display: block; font-size: 18px; font-weight: 600; line-height: 1.5; }
.career-row { padding: 12px 0; }
.career-heading, .career-total { display: flex; justify-content: space-between; gap: 16px; }
.career-heading { font-size: 15px; }
.career-row .meta { display: block; margin-top: 4px; }
.career-total { padding-top: 18px; margin-top: 8px; border-top: 1px solid var(--line); }
.career-total + .meta { display: block; margin-top: 8px; }
.biography { padding-top: 28px; }
.greeting { margin-bottom: 16px; }
.bio-paragraph { display: block; margin-bottom: 16px; }
.technical-terms { display: flex; flex-wrap: wrap; column-gap: 24px; row-gap: 18px; padding: 20px 0 28px; }
.technical-term { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; line-height: 1.6; }
.website-link { display: table; margin-top: 16px; padding-left: 0; color: var(--muted); }
