.shelf-heading { font-size: 22px; line-height: 1.4; font-weight: 600; }
.shelf-intro { margin-top: 7px; font-size: 14px; line-height: 1.6; }
.shelf { margin-top: 24px; }
.shelf-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px; padding: 0 6px; }
button.book {
  display: flex; flex-direction: column; align-items: center; flex: 0 0 calc((100% - 30px) / 4); min-width: 0;
  padding: 10px 6px; border-radius: 3px 5px 2px 1px; text-align: center; line-height: 1.4;
}
.book-number { font-size: 10px; font-weight: 500; opacity: .8; }
.book-name { margin-top: 12px; width: 1em; font-size: 15px; line-height: 1.25; font-weight: 600; word-break: break-all; }
.book-count { margin-top: auto; padding-top: 10px; font-size: 10px; font-weight: 500; }
.shelf-edge { margin: 0 6px; height: 2px; background: var(--quiet); opacity: .3; }
.shelf-base { margin: 0 6px; height: 7px; background: var(--line); }
.browse-all { display: flex; align-items: center; width: 100%; min-height: 48px; margin-top: 24px; padding: 0; font-size: 15px; font-weight: 500; text-align: left; }
.browse-all-meta { display: flex; align-items: center; gap: 8px; margin-left: auto; }
.browse-all-arrow { color: var(--ink); font-size: 15px; }
.search-row { display: flex; align-items: center; margin-top: 8px; gap: 4px; border-bottom: 1px solid var(--line); }
.search-input { flex: 1; width: 0; min-height: 48px; }
.search-placeholder { color: var(--muted); }
.search-button, .clear-button { flex-shrink: 0; padding-left: 10px; padding-right: 10px; }
.clear-button { color: var(--muted); }
.filter-row { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 20px; padding: 4px 0; }
.shelf-link { flex-shrink: 0; padding: 0; min-height: 48px; font-size: 14px; font-weight: 500; }
.filter-picker { max-width: 100%; min-width: 0; }
.filter-label { min-height: 48px; padding: 12px 0; font-size: 14px; font-weight: 500; line-height: 24px; overflow-wrap: anywhere; }
.result-count { margin-top: 16px; font-variant-numeric: tabular-nums; }
.work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 14px; margin-top: 8px; }
button.work-card { display: block; width: 100%; min-height: 44px; padding: 0; text-align: left; border-radius: 0; font-weight: 400; }
.work-thumb-wrap { position: relative; width: 100%; background: var(--line); border-radius: 8px; overflow: hidden; }
.work-thumb-wrap.is-layout { aspect-ratio: 0.72; }
.work-thumb-wrap.is-muse { aspect-ratio: 1.25; }
.work-thumb { width: 100%; height: 100%; }
.image-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; }
.video-badge { position: absolute; right: 8px; bottom: 8px; display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; background: rgba(0, 0, 0, .65); border-radius: 50%; color: #fff; font-size: 10px; }
.work-title { display: -webkit-box; margin-top: 8px; overflow: hidden; font-size: 15px; line-height: 1.6; font-weight: 500; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.work-meta { margin-top: 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* Appended rows only: 220ms ease-out entrance; the animation ends at full opacity with no transform. */
.motion-enter { animation: work-enter 220ms var(--ease-out) backwards; }
@keyframes work-enter { from { opacity: .75; transform: translateY(6px); } to { opacity: 1; transform: none; } }
.more-button { margin-top: 24px; width: 100%; }
.retry-button { margin: 12px auto 0; width: fit-content; }
.attribution { padding-top: 28px; }
@media (min-width: 600px) { .work-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
