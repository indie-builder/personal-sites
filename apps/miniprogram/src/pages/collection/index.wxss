.search-row { display: flex; align-items: center; margin-top: 20px; gap: 4px; border-bottom: 1px solid var(--line); }
.search-input { flex: 1; width: 0; min-height: 48px; }
.search-placeholder { color: var(--muted); }
.search-button, .clear-button { flex-shrink: 0; padding-left: 10px; padding-right: 10px; }
.clear-button { color: var(--muted); }
.filter-row { display: flex; flex-wrap: wrap; gap: 4px 20px; padding: 4px 0; }
.filter-picker { max-width: 100%; min-width: 0; }
.filter-label { min-height: 48px; padding: 12px 0; font-size: 14px; font-weight: 500; line-height: 24px; overflow-wrap: anywhere; }
.result-count { margin-top: 16px; font-variant-numeric: tabular-nums; }
button.work-row { display: flex; align-items: center; gap: 20px; width: 100%; padding: 20px 0; text-align: left; border-radius: 0; font-weight: 400; }
.work-thumb-wrap { flex-shrink: 0; width: 104px; height: 118px; background: var(--paper); border-radius: 8px; overflow: hidden; }
.work-thumb { width: 100%; height: 100%; }
.image-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; }
.work-copy { flex: 1; min-width: 0; }
.work-title { font-size: 15px; line-height: 1.6; font-weight: 500; overflow-wrap: anywhere; }
.work-meta { margin-top: 7px; font-size: 12px; font-weight: 400; }
.more-button { margin-top: 24px; width: 100%; }
.retry-button { margin: 12px auto 0; width: fit-content; }
.attribution { padding-top: 28px; }
@media (max-width: 350px) { button.work-row { gap: 12px; } .work-thumb-wrap { width: 84px; height: 100px; } }
@media (min-width: 600px) { .work-thumb-wrap { width: 144px; height: 150px; } }
