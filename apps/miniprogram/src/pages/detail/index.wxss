.detail-title { display: block; font-size: 26px; line-height: 1.4; letter-spacing: -.03em; word-break: break-word; }
.detail-meta { display: block; margin-top: 14px; }
.reading-section { margin-top: 28px; }
.section-title { display: block; margin-bottom: 10px; font-size: 15px; line-height: 1.6; font-weight: 600; }
.selectable-copy { display: block; white-space: pre-wrap; }
.citation-notice { display: block; margin-top: 28px; font-size: 13px; }
.citation-empty { display: block; margin-top: 20px; }
.recommendation { padding-left: 16px; border-left: 1px solid var(--line); }
.media-list { margin-top: 28px; }
.media-item { margin-bottom: 18px; }
.detail-video { width: 100%; height: 200px; }
.image-preview { display: block; width: 100%; min-height: 44px; padding: 0; border-radius: 10px; overflow: hidden; }
.detail-image { width: 100%; height: auto; }
.media-failure { padding: 20px 0; }
.media-failure button { display: table; margin-top: 12px; }
.tags { display: block; margin-top: 24px; }
.source-actions { display: flex; flex-wrap: wrap; gap: 10px; padding: 28px 0; margin-top: 8px; }
.source-actions button { max-width: 100%; }
.link-hint { display: block; margin-top: 18px; }
.error-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
.back-link { min-height: 44px; padding: 8px 12px; border-radius: 8px; line-height: 28px; font-size: 14px; }
@media (min-width: 500px) { .detail-video { height: 320px; } }
