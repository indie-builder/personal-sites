.identity { display: flex; width: 100%; align-items: center; justify-content: space-between; padding: 0; text-align: left; }
.identity-copy { display: flex; flex-direction: column; gap: 3px; }
.identity-name { font-size: 28px; line-height: 1.4; font-weight: 600; letter-spacing: -.03em; }
.avatar { width: 76px; height: 76px; flex-shrink: 0; }
.introduction { margin-top: 20px; margin-bottom: 28px; }
.bio-paragraph { display: block; margin-bottom: 12px; }
.bio-paragraph:last-child { margin-bottom: 0; }
.section-navigation { position: sticky; top: 0; z-index: 2; width: 100%; background: var(--surface); border-bottom: 1px solid var(--line); white-space: nowrap; }
.section-tabs { display: inline-flex; align-items: stretch; min-width: 100%; }
.section-tab { flex-shrink: 0; min-height: 48px; padding: 9px 12px; border-radius: 0; color: var(--muted); font-size: 14px; white-space: nowrap; }
.section-tab:first-child { padding-left: 0; }
.section-tab-selected { color: var(--ink); font-weight: 600; border-bottom: 2px solid var(--ink); }
.feed-row { display: flex; width: 100%; align-items: flex-start; gap: 16px; text-align: left; border-radius: 0; line-height: 1.6; }
.feed-copy { flex: 1; min-width: 0; }
.feed-title { display: block; color: var(--ink); font-size: 16px; line-height: 1.5; font-weight: 600; overflow-wrap: anywhere; word-break: break-word; }
.feed-summary { display: -webkit-box; margin-top: 7px; font-size: 13px; line-height: 1.7; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; }
.feed-meta { display: block; margin-top: 10px; overflow-wrap: anywhere; }
.feed-thumbnail { width: 90px; height: 70px; flex-shrink: 0; margin-top: 3px; border-radius: 8px; }
.retry-button { display: table; margin: 14px auto 0; }
.refresh-status { display: block; padding-top: 16px; }
.feed-end { display: block; }
.load-more { width: 100%; padding: 18px 0; color: var(--muted); }
@media (max-width: 350px) { .feed-row { gap: 12px; } .feed-thumbnail { width: 72px; height: 60px; } }
