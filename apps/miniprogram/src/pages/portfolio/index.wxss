.portfolio-heading { margin-bottom: 8px; }
.portfolio-heading .muted { margin-top: 5px; font-size: 14px; line-height: 1.6; }
.product { display: flex; width: 100%; align-items: center; gap: 20px; padding: 20px 0; text-align: left; border-radius: 0; font-weight: 400; }
.product-copy { flex: 1; min-width: 0; }
.product-title { font-size: 18px; font-weight: 600; line-height: 1.5; }
.product-summary { margin-top: 9px; font-size: 14px; font-weight: 400; line-height: 1.6; }
.product-date { margin-top: 12px; font-size: 12px; font-weight: 400; }
.product-cover { width: 100px; height: 112px; flex-shrink: 0; background: var(--paper); border-radius: 8px; }
.product-read { flex-shrink: 0; font-size: 13px; font-weight: 400; color: var(--muted); }
.retry-button { margin: 12px auto 0; width: fit-content; }
@media (max-width: 350px) { .product { gap: 12px; } .product-cover { width: 88px; height: 100px; } }
