<view class="page project-page">
  <block wx:if="{{kind === 'tools'}}">
    <view class="muted tool-intro">按分类查找工具，点击复制官网链接。</view>
    <view wx:for="{{categories}}" wx:for-item="category" wx:key="id" class="tool-category">
      <view class="category-title">{{category.name}}</view>
      <view wx:for="{{category.tools}}" wx:for-item="tool" wx:key="url" class="tool-row divider">
        <block wx:if="{{tool.icon && !failedImages[tool.url]}}">
          <image class="tool-icon" src="{{tool.icon}}" mode="aspectFit" lazy-load data-id="{{tool.url}}" binderror="imageFailed" aria-hidden="true" />
        </block>
        <view wx:else class="tool-icon"></view>
        <view class="tool-name">{{tool.name}}</view>
        <button hover-class="motion-press" hover-start-time="0" hover-stay-time="60" wx:if="{{tool.url}}" class="copy-tool" data-url="{{tool.url}}" bindtap="copyUrl" aria-label="{{'复制' + tool.name + '官网链接'}}">复制链接</button>
        <text wx:else class="meta">链接暂缺</text>
      </view>
    </view>
    <view wx:if="{{loaded && !loading && !error && !categories.length}}" class="status">工具目录暂时没有内容。</view>
  </block>
  <block wx:elif="{{site}}">
    <video wx:if="{{site.video && videoMounted && !videoFailed}}" id="site-video" class="site-video" src="{{site.video}}" poster="{{site.poster}}" controls show-center-play-btn object-fit="contain" binderror="videoFailed" aria-label="个人网站介绍视频" />
    <view wx:if="{{videoFailed}}" class="status">
      <view>视频暂时无法播放。</view>
      <button hover-class="motion-press" hover-start-time="0" hover-stay-time="60" class="button" bindtap="retryVideo">重新加载视频</button>
    </view>
    <view class="body site-description"><text selectable>{{site.description}}</text></view>
    <button hover-class="motion-press" hover-start-time="0" hover-stay-time="60" wx:if="{{site.website}}" class="button source-button" data-url="{{site.website}}" bindtap="copyUrl">复制网站链接</button>
  </block>
  <view wx:if="{{loading}}" class="status" aria-live="polite">正在读取{{kind === 'tools' ? '工具目录' : '网站介绍'}}…</view>
  <view wx:if="{{error}}" class="status" role="alert">
    <view class="error">{{error}}</view>
    <button hover-class="motion-press" hover-start-time="0" hover-stay-time="60" wx:if="{{!invalid}}" class="button retry-button" bindtap="loadContent" disabled="{{loading}}">重新读取</button>
  </view>
</view>
