.work-content.motion-enter { animation: work-content-in 160ms var(--ease-out); }
@keyframes work-content-in { from { opacity: .75; transform: translateY(4px); } to { opacity: 1; transform: none; } }
.media-item { margin-bottom: 12px; }
button.image-button { width: 100%; min-height: 44px; padding: 0; line-height: 0; border-radius: 8px; overflow: hidden; }
.work-image { width: 100%; height: auto; background: var(--paper); }
.work-video { display: block; max-height: 80vh; background: var(--paper); border-radius: 8px; }
.work-title { margin-top: 12px; font-size: 22px; font-weight: 600; }
.work-meta { margin-top: 8px; font-size: 12px; font-weight: 400; }
.work-text { margin-top: 20px; font-size: 15px; font-weight: 400; white-space: pre-wrap; }
button.source-button { width: 100%; min-height: 48px; margin-top: 24px; text-align: left; }
.attribution { margin-top: 16px; }
.no-media, .media-error { background: var(--paper); border-radius: 8px; padding: 32px 16px; }
.retry-button { margin: 12px auto 0; width: fit-content; }
.work-page.has-navigation { padding-bottom: calc(100px + env(safe-area-inset-bottom)); }
.work-navigation {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1;
  max-width: 760px;
  margin: 0 auto;
  padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8px;
  border-top: 1px solid var(--line);
  background: var(--surface);
}
.work-navigation button { min-width: 80px; min-height: 48px; font-size: 14px; font-weight: 500; }
.work-position { flex: 1; text-align: center; font-variant-numeric: tabular-nums; }
