{
  "name": "@site/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/prepare-data.mjs && bun --import ./scripts/load-env.mjs node_modules/vite/bin/vite.js",
    "build": "node scripts/prepare-data.mjs && node --import ./scripts/load-env.mjs node_modules/vite/bin/vite.js build",
    "start": "node --import ./scripts/load-env.mjs scripts/start-server.mjs",
    "lint": "oxlint --deny-warnings app src components e2e lib scripts tests '*.config.{js,mjs,ts}'",
    "typecheck": "bun scripts/prepare-data.mjs && bun ../../scripts/tsc7.mjs --noEmit",
    "test": "bun scripts/prepare-data.mjs && vitest run",
    "test:e2e": "bun run build && bun scripts/e2e-agent-run.mjs",
    "test:e2e:touch": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.87",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shadcn/react": "^0.3.1",
    "@site/effect": "workspace:*",
    "@site/public-data": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@typesafe-ai/sdk": "^0.7.0",
    "ai": "7.0.150",
    "better-sqlite3": "^13.0.3",
    "clsx": "2.1.1",
    "effect": "4.0.6",
    "katex": "0.19.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "nitro": "^3.0.260903-beta",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "satori": "0.63.2",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "e2e": "0.21.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
