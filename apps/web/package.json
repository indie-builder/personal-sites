{
  "name": "@site/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-data.mjs && node --import ./scripts/load-env.mjs node_modules/next/dist/bin/next dev --turbopack --hostname 127.0.0.1",
    "build": "node scripts/prepare-data.mjs && node --import ./scripts/load-env.mjs node_modules/next/dist/bin/next build",
    "start": "node --import ./scripts/load-env.mjs node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "lint": "oxlint --deny-warnings app components e2e lib scripts tests '*.config.{js,mjs,ts}'",
    "typecheck": "node ../../scripts/tsc7.mjs --noEmit",
    "test": "node scripts/prepare-data.mjs && vitest run && node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.63",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@shadcn/react": "^0.3.1",
    "@site/effect": "workspace:*",
    "@site/public-data": "workspace:*",
    "@supabase/supabase-js": "2.116.0",
    "ai": "7.0.114",
    "better-sqlite3": "^13.0.3",
    "clsx": "2.1.1",
    "effect": "3.22.2",
    "lucide-react": "1.47.0",
    "motion": "^13.4.0",
    "next": "16.3.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
