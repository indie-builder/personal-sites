{
  "name": "chen-yuan-personal-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/content"
  ],
  "trustedDependencies": [
    "@huggingface/tokenizers",
    "better-sqlite3",
    "esbuild",
    "onnxruntime-node",
    "sharp"
  ],
  "portless": {
    "name": "personal-site",
    "script": "dev",
    "appPort": 3000
  },
  "scripts": {
    "dev": "bun run --filter @site/web dev",
    "dev:domain": "portless",
    "build": "turbo run build",
    "start": "bun run --filter @site/web start",
    "lint": "turbo run lint lint:repo",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:repo",
    "test:e2e": "bun run --filter @site/web test:e2e",
    "test:e2e:touch": "bun run --filter @site/web test:e2e:touch",
    "health:production": "bun scripts/check-production-health.mjs",
    "supabase:push": "bun scripts/supabase-db-push.mjs",
    "git:safety": "bun scripts/verify-git-safety.mjs --range HEAD",
    "git:hooks:install": "bun scripts/install-git-hooks.mjs",
    "prepare": "bun scripts/install-git-hooks.mjs --if-present",
    "lint:repo": "oxlint --deny-warnings scripts config tests",
    "test:repo": "bun test tests/*.test.mjs",
    "curation:prepare": "bun run --filter @site/content curation:prepare",
    "curation:recover": "bun run --filter @site/content curation:recover",
    "curation:import": "bun run --filter @site/content curation:import",
    "curation:fetch": "bun run --filter @site/content curation:fetch",
    "curation:history": "bun run --filter @site/content curation:history",
    "curation:sync": "bun run --filter @site/content curation:sync",
    "curation:sync:glm": "bun run --filter @site/content curation:sync:glm",
    "curation:sync:luna": "bun run --filter @site/content curation:sync:luna",
    "curation:enrich": "bun run --filter @site/content curation:enrich",
    "curation:classify-design": "bun run --filter @site/content curation:classify-design",
    "curation:build": "bun run --filter @site/content curation:build",
    "curation:publish": "bun run --filter @site/content curation:publish",
    "douyin:curation": "bun run --filter @site/content douyin:curation",
    "douyin:sync": "bun run --filter @site/content douyin:sync",
    "github:starred:sync": "bun run --filter @site/content github:starred:sync",
    "github:starred:init": "bun run --filter @site/content github:starred:init",
    "github:starred:daily": "bun run --filter @site/content github:starred:daily",
    "github:starred:analyze": "bun run --filter @site/content github:starred:analyze",
    "github:starred:analyze:pi": "bun run --filter @site/content github:starred:analyze:pi",
    "github:starred:publish": "bun run --filter @site/content github:starred:publish",
    "ai-news:archive": "bun run --filter @site/content ai-news:archive",
    "ai-news:prune": "bun run --filter @site/content ai-news:prune",
    "ai-news:sync": "bun run --filter @site/content ai-news:sync",
    "ai-news:backfill": "bun run --filter @site/content ai-news:backfill",
    "focus:status": "bun run --filter @site/content focus:status",
    "vectors:index": "bun run --filter @site/content vectors:index",
    "vectors:search": "bun run --filter @site/content vectors:search",
    "github:starred:run": "bun run --filter @site/content github:starred:run"
  },
  "overrides": {
    "fflate@0.7.3": "0.7.5",
    "katex": "0.19.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.1",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "^1.88.0",
    "portless": "^0.15.8",
    "typescript": "7.0.2",
    "turbo": "2.11.9"
  }
}
