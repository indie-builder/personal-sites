{
  "name": "chen-yuan-personal-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "portless": {
    "name": "personal-site",
    "script": "dev",
    "appPort": 3000
  },
  "scripts": {
    "dev": "pnpm --filter @site/web dev",
    "dev:domain": "portless",
    "build": "turbo run build",
    "start": "pnpm --filter @site/web start",
    "lint": "turbo run lint lint:repo",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:repo",
    "test:e2e": "pnpm --filter @site/web test:e2e",
    "test:e2e:touch": "pnpm --filter @site/web test:e2e:touch",
    "health:production": "node scripts/check-production-health.mjs",
    "supabase:push": "node scripts/supabase-db-push.mjs",
    "git:safety": "node scripts/verify-git-safety.mjs --range HEAD",
    "git:hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs --if-present",
    "lint:repo": "oxlint --deny-warnings scripts config tests",
    "test:repo": "node --test tests/*.test.mjs",
    "curation:prepare": "pnpm --filter @site/content curation:prepare",
    "curation:recover": "pnpm --filter @site/content curation:recover",
    "curation:import": "pnpm --filter @site/content curation:import",
    "curation:fetch": "pnpm --filter @site/content curation:fetch",
    "curation:history": "pnpm --filter @site/content curation:history",
    "curation:sync": "pnpm --filter @site/content curation:sync",
    "curation:sync:glm": "pnpm --filter @site/content curation:sync:glm",
    "curation:sync:luna": "pnpm --filter @site/content curation:sync:luna",
    "curation:enrich": "pnpm --filter @site/content curation:enrich",
    "curation:classify-design": "pnpm --filter @site/content curation:classify-design",
    "curation:build": "pnpm --filter @site/content curation:build",
    "curation:publish": "pnpm --filter @site/content curation:publish",
    "douyin:curation": "pnpm --filter @site/content douyin:curation",
    "douyin:sync": "pnpm --filter @site/content douyin:sync",
    "github:starred:sync": "pnpm --filter @site/content github:starred:sync",
    "github:starred:init": "pnpm --filter @site/content github:starred:init",
    "github:starred:daily": "pnpm --filter @site/content github:starred:daily",
    "github:starred:analyze": "pnpm --filter @site/content github:starred:analyze",
    "github:starred:analyze:pi": "pnpm --filter @site/content github:starred:analyze:pi",
    "github:starred:publish": "pnpm --filter @site/content github:starred:publish",
    "ai-news:archive": "pnpm --filter @site/content ai-news:archive",
    "ai-news:prune": "pnpm --filter @site/content ai-news:prune",
    "ai-news:sync": "pnpm --filter @site/content ai-news:sync",
    "ai-news:backfill": "pnpm --filter @site/content ai-news:backfill",
    "focus:status": "pnpm --filter @site/content focus:status",
    "vectors:index": "pnpm --filter @site/content vectors:index",
    "vectors:search": "pnpm --filter @site/content vectors:search",
    "github:starred:run": "pnpm --filter @site/content github:starred:run"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@types/node": "26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "^1.87.0",
    "portless": "^0.15.7",
    "typescript": "7.0.2",
    "turbo": "2.11.7"
  }
}
