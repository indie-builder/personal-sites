{
  "name": "@site/content",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun ../../scripts/tsc7.mjs --noEmit",
    "lint": "oxlint --deny-warnings scripts modules lib tests",
    "test": "bun test tests/ && node --test tests/cli.node-test.mjs tests/bigmodel.node-test.mjs tests/douyin-curation.node-test.mjs",
    "curation:prepare": "bun scripts/x-curation-prepare.mjs",
    "curation:recover": "bun scripts/recover-x-curation-queue.mjs",
    "curation:import": "bun scripts/x-curation-import-bird.mjs",
    "curation:fetch": "bun scripts/x-curation-sync.mjs --fetch-only",
    "curation:history": "bun scripts/x-curation-sync.mjs --history",
    "curation:sync": "bun scripts/x-curation-sync.mjs",
    "curation:sync:glm": "bun scripts/x-curation-sync.mjs --engine pi",
    "curation:sync:luna": "bun scripts/x-curation-sync.mjs --engine codex-cli --model gpt-5.6-luna --reasoning-effort max",
    "curation:enrich": "bun scripts/x-curation-enrich.mjs",
    "curation:classify-design": "bun scripts/x-curation-enrich.mjs --design-only --engine pi --concurrency 15",
    "curation:build": "bun scripts/build-curation-content.mjs",
    "curation:publish": "bun scripts/build-curation-sqlite.mjs",
    "douyin:curation": "bun scripts/douyin-curation.mjs",
    "douyin:sync": "bun scripts/douyin-full-sync.mjs",
    "github:starred:sync": "bun scripts/github-starred.mjs sync",
    "github:starred:init": "bun scripts/github-starred.mjs init",
    "github:starred:daily": "bun scripts/github-starred.mjs daily",
    "github:starred:analyze": "bun scripts/github-starred.mjs analyze",
    "github:starred:analyze:pi": "bun scripts/github-starred.mjs analyze --engine pi",
    "github:starred:publish": "bun scripts/github-starred.mjs publish",
    "ai-news:archive": "bun scripts/ai-news-archive.mjs",
    "ai-news:prune": "bun scripts/ai-news-archive.mjs --prune",
    "ai-news:sync": "bun scripts/ai-news-sync.mjs",
    "ai-news:backfill": "bun scripts/ai-news-sync.mjs --backfill",
    "focus:status": "bun scripts/focus-status.mjs",
    "vectors:index": "bun scripts/local-vectors.mjs index",
    "vectors:search": "bun scripts/local-vectors.mjs search",
    "github:starred:run": "bun scripts/github-starred.mjs run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@huggingface/transformers": "4.3.1",
    "@site/effect": "workspace:*",
    "@site/public-data": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "better-sqlite3": "^13.0.3",
    "effect": "4.0.1",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@steipete/bird": "^0.8.0"
  }
}
