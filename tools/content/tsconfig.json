{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "modules/analysis/model-runner.mjs",
    "modules/analysis/retry.mjs",
    "modules/portfolio/**/*.ts",
    "tests/*.types.mts"
  ]
}
